# Smart Traffic Management System — Environment Variables
# Copy this file to .env and adjust the values.
# All variables have safe defaults — only set what you need to override.

# ── Flask ──────────────────────────────────────────────────────────────────
# Host to bind to. Use 0.0.0.0 to expose on the local network.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Set to true only during local development — NEVER in production.
FLASK_DEBUG=false
FLASK_THREADED=true
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── File paths ─────────────────────────────────────────────────────────────
# Absolute path to the YOLO model weights file.
# Default resolves to <workspace_root>/yolov8m.pt
YOLO_MODEL_PATH=

# Absolute path to the SQLite database file.
# Default: <project_dir>/traffic_logs.db
DATABASE_PATH=

# Video source: file path, camera index (0), RTSP URL, or YouTube URL.
# Default: <project_dir>/data/intersectie_romana.mp4
VIDEO_SOURCE_PATH=

# Q-table checkpoint to load at startup (agent trains fresh if missing).
# Default: <project_dir>/q_table_medium_final.json
Q_TABLE_PATH=

# Path to benchmark_results.json produced by `python -m traffic_monitor.agent.q_learning --mode benchmark`
# Default: <project_dir>/benchmark_results.json
BENCHMARK_RESULTS_PATH=

# ── YOLO detection ─────────────────────────────────────────────────────────
DETECTION_CONFIDENCE_THRESHOLD=0.20
YOLO_INFERENCE_SIZE=640
# Run YOLO every Nth frame (higher = faster but less responsive)
YOLO_SKIP_INTERVAL=3

# Per-class minimum confidence (applied after DETECTION_CONFIDENCE_THRESHOLD)
CONF_PERSON=0.65
CONF_MOTORCYCLE=0.40
CONF_BICYCLE=0.45

# ── Traffic monitoring ─────────────────────────────────────────────────────
# Number of vehicles that represents 100% congestion
CONGESTION_THRESHOLD=25

# ── Video capture ──────────────────────────────────────────────────────────
DEFAULT_CAMERA_INDEX=0
TARGET_FPS=30
# JPEG quality for the streaming endpoint (1-100)
VIDEO_ENCODING_QUALITY=60

# ── Database ───────────────────────────────────────────────────────────────
# How often (seconds) to write a traffic snapshot to SQLite
DB_LOGGING_INTERVAL=10
DB_CONNECTION_TIMEOUT=10
DB_MAX_RETRIES=3
DB_RETRY_DELAY=5

# ── Logging ────────────────────────────────────────────────────────────────
# One of: DEBUG INFO WARNING ERROR CRITICAL
LOG_LEVEL=INFO
# Python logging format string
# LOG_FORMAT=[%(asctime)s] %(levelname)-8s %(name)s: %(message)s
